# =========================================================================
# Variables de entorno — V Torneig de Pàdel les Coves de Vinromà 2026
# =========================================================================
#
# Copia este archivo a `.env.local` y rellena los valores. NUNCA commits
# .env.local — está en .gitignore.
#
# El RUNBOOK.md explica de dónde sacar cada valor.

# -------------------------------------------------------------------------
# Supabase
# -------------------------------------------------------------------------
# Proyecto Supabase: https://supabase.com/dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...                        # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...                            # service role (server-only, NUNCA al cliente)
# Cadena de conexión Postgres directa (solo para backups/CI con pg_dump).
# Project Settings → Database → Connection string (URI). NUNCA al cliente.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# -------------------------------------------------------------------------
# Resend (email transaccional)
# -------------------------------------------------------------------------
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# FROM ha de ser un domini verificat a Resend (no onboarding@resend.dev, que
# només envia a la teva pròpia adreça).
RESEND_FROM_EMAIL=Torneig Pàdel les Coves <info@neonexai.com>
# Reply-To opcional: les respostes dels inscriptors hi arriben (p.ex. el Gmail
# del club). Si es deixa buit, no s'aplica cap reply-to per defecte.
RESEND_REPLY_TO=clubpadelvinroma@gmail.com

# -------------------------------------------------------------------------
# Auth - PIN del capita
# -------------------------------------------------------------------------
# Secret per signar les cookies de PIN i dispositiu (HMAC-SHA256). Si es
# deixa buit, es deriva automaticament de SUPABASE_SERVICE_ROLE_KEY.
AUTH_COOKIE_SECRET=

# -------------------------------------------------------------------------
# Site
# -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000                      # cambiar en prod a https://torneig-local-padel-2026-vinroma.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=ca

# -------------------------------------------------------------------------
# Sentry (observabilidad)
# -------------------------------------------------------------------------
# Si NEXT_PUBLIC_SENTRY_DSN está vacío, Sentry es no-op (no envía eventos).
# Solo se activa en producción (NODE_ENV=production) y con DSN presente.
NEXT_PUBLIC_SENTRY_DSN=
# Subida de source maps en build (CI/Vercel). Si falta SENTRY_AUTH_TOKEN, el
# build NO falla: simplemente se omite la subida.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Muestreo de trazas de rendimiento (0.0–1.0). Por defecto 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Muestreo de session replay en error (0.0–1.0). Por defecto 0 (desactivado).
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# -------------------------------------------------------------------------
# WhatsApp — Evolution API (self-hosted)
# -------------------------------------------------------------------------
# Si falten, els avisos de WhatsApp són no-op (no trenquen res).
EVOLUTION_API_URL=https://evo.neonexai.com
EVOLUTION_API_KEY=                                             # apikey de la instance (MAI al repo)
EVOLUTION_INSTANCE=                                            # nom de la instance amb el número connectat
WHATSAPP_ADMIN_NUMBER=                                         # opcional: número (34...) per a avisos de disputa
WHATSAPP_GROUP_JID=                                            # JID del grup de gestió (format: <digits>-<digits>@g.us)

# -------------------------------------------------------------------------
# Cron (recordatoris de partit per WhatsApp)
# -------------------------------------------------------------------------
# Secret que Vercel Cron envia com Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
