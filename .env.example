# =========================================================================
# Variables de entorno — V Torneig de Pàdel les Coves de Vinromà 2026
# =========================================================================
#
# Copia este archivo a `.env.local` y rellena los valores. NUNCA commits
# .env.local — está en .gitignore.
#
# El RUNBOOK.md explica de dónde sacar cada valor.

# -------------------------------------------------------------------------
# Supabase
# -------------------------------------------------------------------------
# Proyecto Supabase: https://supabase.com/dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...                        # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...                            # service role (server-only, NUNCA al cliente)

# -------------------------------------------------------------------------
# Resend (email transaccional)
# -------------------------------------------------------------------------
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# FROM ha de ser un domini verificat a Resend (no onboarding@resend.dev, que
# només envia a la teva pròpia adreça).
RESEND_FROM_EMAIL=Torneig Pàdel les Coves <info@neonexai.com>
# Reply-To opcional: les respostes dels inscriptors hi arriben (p.ex. el Gmail
# del club). Si es deixa buit, no s'aplica cap reply-to per defecte.
RESEND_REPLY_TO=clubpadelvinroma@gmail.com

# -------------------------------------------------------------------------
# Site
# -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000                      # cambiar en prod a torneigpadelvinroma-v-2026.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=ca

# -------------------------------------------------------------------------
# Sentry (observabilidad) — Sprint 5+, déjalo vacío en Sprint 1
# -------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# -------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — Sprint 4+, déjalo vacío en Sprint 1
# -------------------------------------------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
